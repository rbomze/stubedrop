{
  "manifest_version": 3,
  "name": "S-Tube Drop",
  "version": "0.13",
  "description": "Send the current YouTube video to SmartTube on your Android TV via the S-Tube Drop receiver app.",
  "icons": {
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "contextMenus"
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stubedrop@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Send this video to the TV (S-Tube Drop)",
    "default_icon": "icons/icon.svg",
    "default_area": "navbar",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}